DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-secret"

# Paystack server secret. Use sk_test_... locally and sk_live_... in production.
PAYSTACK_SECRET_KEY="sk_test_replace_me"

# Public origin used for Paystack callback URLs and email links. No trailing slash.
APP_URL="http://localhost:3000"

# Transactional email over SMTP, using the organization's cPanel mailbox
# (cPanel → Email Accounts → Connect Devices → "Mail Client Manual Settings").
# Without SMTP_HOST/SMTP_USER/SMTP_PASS, emails are skipped (logged) and the app still works.
SMTP_HOST="mail.piousmuslimwomen.org.ng"
SMTP_PORT="465"
# true for implicit SSL/TLS on port 465 (default when SMTP_PORT is 465); false for STARTTLS on 587.
# SMTP_SECURE="true"
SMTP_USER="admin@piousmuslimwomen.org.ng"
SMTP_PASS="the-mailbox-password"
# Sender shown to recipients. Shared hosts reject mail whose From address isn't
# the authenticated mailbox, so keep the address equal to SMTP_USER.
EMAIL_FROM="PMWIO <admin@piousmuslimwomen.org.ng>"
# Optional: address replies should go to (e.g. a monitored inbox).
# EMAIL_REPLY_TO="info@piousmuslimwomen.org.ng"
# Optional: how many hidden recipients per message on broadcasts (default 50).
# EMAIL_BCC_BATCH_SIZE="50"
