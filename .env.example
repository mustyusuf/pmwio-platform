DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-secret"

# Paystack server secret. Use sk_test_... locally and sk_live_... in production.
PAYSTACK_SECRET_KEY="sk_test_replace_me"

# Public origin used for Paystack callback URLs and email links. No trailing slash.
APP_URL="http://localhost:3000"

# Transactional email (Resend). Create a key at https://resend.com/api-keys.
# Without RESEND_API_KEY, emails are skipped (logged) and the app still works.
RESEND_API_KEY="re_replace_me"
# Verified sender. Use your verified domain once its DNS is confirmed; before then
# you can fall back to "PMWIO <onboarding@resend.dev>" (only delivers to your own
# Resend account email).
EMAIL_FROM="PMWIO <noreply@piousmuslimwomen.org.ng>"
# Optional: address replies should go to (e.g. a monitored inbox).
# EMAIL_REPLY_TO="info@piousmuslimwomen.org.ng"
